{
  "name": "playwright-e2e-mcp",
  "version": "0.7.0",
  "description": "MCP server and agent skill that run, diagnose and fix failing Playwright tests: CI report diagnosis, trace analysis, verified locator fixes, flaky verdicts, breaking commits, tests written by walking the flow, accessibility and Web Vitals audits.",
  "author": "xsignon-secure (https://github.com/xsignon-secure)",
  "mcpName": "io.github.xsignon-secure/E2E",
  "type": "module",
  "license": "MIT",
  "homepage": "https://playwright-e2e-mcp.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xsignon-secure/E2E.git"
  },
  "bugs": {
    "url": "https://github.com/xsignon-secure/E2E/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playwright",
    "e2e",
    "end-to-end-testing",
    "testing",
    "ai",
    "automation",
    "selectors",
    "flaky-tests",
    "github-action",
    "ci",
    "agent-skills",
    "claude-code-plugin",
    "gemini-cli-extension",
    "accessibility",
    "axe-core",
    "wcag",
    "open-source",
    "free"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "playwright-e2e-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "skill/playwright-e2e-mcp",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node test/run-tests.mjs",
    "coverage": "npm run build && node test/run-tests.mjs --coverage",
    "e2e": "npm run build && node e2e/run.mjs",
    "mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "mcpb:smoke": "npm run mcpb && node scripts/mcpb-launch-sim.mjs && node scripts/mcpb-client-check.mjs",
    "mcpb:sign": "npm run mcpb && node scripts/sign-mcpb.mjs",
    "skill:zip": "node scripts/package-skill.mjs build",
    "skill:package": "node scripts/package-skill.mjs package",
    "skill:check": "node scripts/package-skill.mjs check",
    "release:assemble": "node scripts/assemble-release.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "axe-core": "^4.14.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
