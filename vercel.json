{
  "functions": {
    "api/mcp.ts": {
      "includeFiles": "examples/**"
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/mcp?oauth_route=/.well-known/oauth-protected-resource/:path*"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp?oauth_route=/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/mcp?oauth_route=/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp?oauth_route=/.well-known/oauth-authorization-server"
    },
    {
      "source": "/oauth/:endpoint(register|authorize|token)",
      "destination": "/api/mcp?oauth_route=/oauth/:endpoint"
    }
  ]
}
